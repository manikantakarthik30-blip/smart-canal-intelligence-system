# Public origin of the deployed SCIS frontend, comma-separated if needed.
SCIS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Path to a compatible, licensed YOLO model trained on canal-waste classes.
SCIS_MODEL_PATH=/app/models/floating_waste.pt

# Analyze one frame out of every N frames; larger values reduce CPU usage.
SCIS_FRAME_STRIDE=5
SCIS_CONFIDENCE=0.35

# Set by AppSail/container platform; local default is 8080.
PORT=8080
